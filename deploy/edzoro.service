# Brings the Edzoro stack up at boot from /srv/edzoro.
#
# Install:
#   sudo cp deploy/edzoro.service /etc/systemd/system/edzoro.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now edzoro.service
#
# Same rootless-podman setup as pte.service: XDG_RUNTIME_DIR must point at the
# *user* runtime directory (1000 == `id -u nitin` on the NUC).

[Unit]
Description=Edzoro site (podman compose)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=nitin
Group=nitin
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/srv/edzoro
ExecStart=/usr/bin/podman compose up -d
ExecStop=/usr/bin/podman compose down
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
